{
  "name": "portfolio-update",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.11.0",
    "npm": "11.6.1"
  },
  "packageManager": "npm@11.6.1",
  "dependencies": {
    "react": "^19.2.6",
    "react-dom": "^19.2.6"
  },
  "scripts": {
    "start": "vite --host 127.0.0.1",
    "start:headless": "vite --host 127.0.0.1",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "npm run typecheck && PLAYWRIGHT_BROWSERS_PATH=.playwright playwright test",
    "test:headed": "PLAYWRIGHT_BROWSERS_PATH=.playwright playwright test --headed",
    "test:ui": "PLAYWRIGHT_BROWSERS_PATH=.playwright playwright test --ui",
    "test:headless": "npm run test",
    "playwright:install": "PLAYWRIGHT_BROWSERS_PATH=.playwright playwright install chromium",
    "playwright:install:ci": "PLAYWRIGHT_BROWSERS_PATH=.playwright playwright install --with-deps chromium",
    "docker:security": "docker run --rm --network=host -e SCAN_URL=\"http://127.0.0.1:5173\" lirantal/is-website-vulnerable:latest",
    "test:security": "start-server-and-test start:headless http://127.0.0.1:5173 docker:security"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@playwright/test": "^1.60.0",
    "@types/node": "^24.11.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "sass": "^1.99.0",
    "start-server-and-test": "^3.0.5",
    "typescript": "^6.0.3",
    "vite": "^8.0.13"
  }
}
